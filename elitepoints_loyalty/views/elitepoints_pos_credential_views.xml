<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="elitepoints_pos_credential_view_form" model="ir.ui.view">
        <field name="name">elitepoints.pos.credential.view.form</field>
        <field name="model">elitepoints.pos.credential</field>
        <field name="arch" type="xml">
            <form string="ElitePoints Credentials">
                <field name="config_id" invisible="1"/>
                <group>
                    <field name="api_key" placeholder="odok_live_..."/>
                    <field name="api_secret" placeholder="odos_live_..." password="True"/>
                    <field name="base_url"/>
                </group>
                <footer>
                    <button name="action_elitepoints_test_connection"
                            type="object"
                            string="Test Connection"
                            class="btn-secondary"/>
                    <button string="Close" special="cancel" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
