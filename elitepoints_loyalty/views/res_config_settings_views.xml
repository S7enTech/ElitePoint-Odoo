<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_elitepoints" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.elitepoints</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='point_of_sale']" position="inside">
                <block title="ElitePoints" name="elitepoints_setting_container">
                    <setting id="elitepoints_setting"
                             string="ElitePoints Loyalty"
                             help="Connect this store to the ElitePoints loyalty network.">
                        <field name="elitepoints_api_key" placeholder="odok_live_..."/>
                        <div class="content-group">
                            <field name="elitepoints_api_secret" placeholder="odos_live_..." password="True"/>
                        </div>
                        <div class="content-group">
                            <label for="elitepoints_base_url" string="API URL"/>
                            <field name="elitepoints_base_url"/>
                        </div>
                        <div class="content-group">
                            <button name="action_elitepoints_test_connection"
                                    type="object"
                                    string="Test Connection"
                                    class="btn-secondary"/>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
