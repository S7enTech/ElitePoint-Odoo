<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="elitepoints_loyalty.ElitePointsDialog">
        <Dialog title="'ElitePoints'" size="'md'">
            <div class="elitepoints-dialog">
                <div class="mb-3">
                    <div class="btn-group mb-2" role="group">
                        <button type="button"
                                class="btn btn-sm"
                                t-att-class="state.lookupType === 'phone' ? 'btn-primary' : 'btn-outline-primary'"
                                t-on-click="() => this.setLookupType('phone')">
                            Phone
                        </button>
                        <button type="button"
                                class="btn btn-sm"
                                t-att-class="state.lookupType === 'email' ? 'btn-primary' : 'btn-outline-primary'"
                                t-on-click="() => this.setLookupType('email')">
                            Email
                        </button>
                        <button type="button"
                                class="btn btn-sm"
                                t-att-class="state.lookupType === 'barcode' ? 'btn-primary' : 'btn-outline-primary'"
                                t-on-click="() => this.setLookupType('barcode')">
                            Loyalty Card
                        </button>
                    </div>
                    <div class="input-group">
                        <input type="text"
                               class="form-control"
                               placeholder="Enter customer phone, email, or scan card"
                               t-model="state.identifier"
                               t-on-keydown="(ev) => ev.key === 'Enter' ? this.lookupCustomer() : null"/>
                        <button class="btn btn-primary"
                                t-on-click="lookupCustomer"
                                t-att-disabled="state.loading">
                            <t t-if="state.loading">Looking up…</t>
                            <t t-else="">Look Up</t>
                        </button>
                    </div>
                </div>

                <div t-if="state.error" class="alert alert-danger" role="alert">
                    <t t-esc="state.error"/>
                </div>

                <div t-if="state.customer" class="elitepoints-customer-card p-3 border rounded">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <strong t-esc="(state.customer.firstName or '') + ' ' + (state.customer.lastName or '')"/>
                        </div>
                        <div class="text-end">
                            <div class="fs-4 fw-bold" t-esc="state.customer.pointsBalance"/>
                            <div class="text-muted small">points available</div>
                        </div>
                    </div>

                    <div class="mt-3" t-if="maxRedeemable > 0">
                        <label class="form-label">Redeem toward this sale</label>
                        <input type="number"
                               class="form-control"
                               min="0"
                               t-att-max="maxRedeemable"
                               t-model.number="state.redeemAmount"/>
                        <div class="form-text">
                            Up to <t t-esc="maxRedeemable"/> can be redeemed on this order.
                        </div>
                    </div>
                    <div class="mt-3 text-muted small" t-else="">
                        No points available to redeem right now.
                    </div>
                </div>
            </div>

            <t t-set-slot="footer">
                <button class="btn btn-secondary" t-on-click="cancel">Cancel</button>
                <button class="btn btn-primary" t-att-disabled="!state.customer" t-on-click="confirm">
                    Apply
                </button>
            </t>
        </Dialog>
    </t>

</templates>
